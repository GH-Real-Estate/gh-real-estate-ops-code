// =================================================================================================
// FILE: Monthly_Interest_Billing.deluge
// TARGET: Zoho Books > Automation > Schedules > Custom Function
// VERSION: v1.7_PARTIAL_PAYMENT_PRESERVATION
// PATCHED: 2026-07-17
//
// PURPOSE
//   Creates monthly simple-interest invoices for delinquent rent balances only.
//
// LEASE ALIGNMENT
//   Lease Section 3.6 has two separate rules:
//   1) Eligibility: interest may be assessed only after unpaid Rent remains unpaid more than 30 days
//      after the original due date.
//   2) Accrual: once eligible, simple interest is calculated from the original due date until paid.
//
// WHY THIS FUNCTION IS SEPARATE
//   Late fees are stage-based and belong in the Late Fee Guard.
//   Returned-payment / NSF fees are payment-event based and belong in the Zoho Payments/Catalyst RF webhook.
//   Monthly interest is period-based and runs separately so accounting review stays clean.
//
// SAVE-FIX NOTE
//   This version avoids `for each` loops directly over response.get(...) expressions because some
//   Zoho Books schedule editors reject those inline expressions during save. API response lists are
//   assigned to named List variables before iteration.
//
// ACCOUNTING SAFETY
//   - Only invoices marked as rent with cf_is_rent_invoice == true are eligible.
//   - Fee-only invoices, deposits, returned-payment fees, late fees, and interest invoices are skipped.
//   - Interest is simple interest only. It is not compounded and is not charged on fees.
//   - Duplicate prevention uses both customer-period invoice references and source-invoice tokens.
//   - Source and created-invoice updates preserve the source invoice's top-level allow_partial_payments value.
// =================================================================================================
apiBase = "https://www.zohoapis.com/books/v3";
// -------------------- CONTEXT --------------------
orgId = "";
if(organization != null && organization.get("organization_id") != null)
{
	orgId = organization.get("organization_id").toString();
}
if(orgId == "")
{
	info "ERROR: Missing organization_id from Zoho Books schedule context.";
	return;
}
today = zoho.currentdate;
nowStr = zoho.currenttime.toString("yyyy-MM-dd HH:mm");
periodKey = today.toString("yyyyMM");
periodToken = "INTPERIOD_" + periodKey;
interestThroughDate = today;
interestThroughDateString = interestThroughDate.toString("yyyy-MM-dd");
// -------------------- CONFIG --------------------
interestInvoicePrefix = "INT-";
interestInvoiceNumberDigits = 6;
interestItemId = "CONFIG_REQUIRED_INTEREST_ITEM_ID";
interestAprPct = 10.00;
// Eligibility: do not assess until unpaid Rent is more than 30 days delinquent.
interestFirstEligibleDaysAfterDue = 31;
// Accrual: once eligible, calculate from the original rent due date under Lease Section 3.6.
interestStartsDaysAfterDue = 0;
interestMinimumInvoiceAmount = 10.00;
// Invoice custom fields.
stagesFieldApiName = "cf_late_fee_stages_applied";
rentInvoiceFlagApiName = "cf_is_rent_invoice";
invoiceDoNotAssessApiName = "cf_do_not_assess_fees";
invoiceFeeExemptApiName = "cf_fee_exempt";
invoiceFeeExemptUntilApiName = "cf_fee_exempt_until";
// Contact custom fields.
customerFeeExemptApiName = "cf_fee_exempt";
customerFeeExemptUntilApiName = "cf_fee_exempt_until";
// Tokens stored in cf_late_fee_stages_applied on the source rent invoice.
lastBalanceTokenPrefix = "LASTBAL=";
interestLastThroughTokenPrefix = "INTTHRU=";
interestTotalTokenPrefix = "INTTOTAL=";
interestInvoiceIdTokenPrefix = "INTINV_";
// Invoice delivery.
autoEmailInterestInvoices = true;
markInvoicesAsSentBeforeEmail = true;
enableRecipientFallbackToCustomerEmail = true;
interestInvoiceEmailTemplateName = "Fee Invoice - Monthly Interest";
interestInvoiceEmailTemplateId = "";
// Payment options. First preference is to inherit from the source rent invoice.
inheritSourceInvoicePdfTemplate = true;
inheritSourceInvoicePaymentOptions = true;
enableOnlinePaymentsForInterestInvoices = true;
forcePaymentGatewayName = "zoho_payments";
// Runtime bounds.
invoiceListFilterBy = "Status.Unpaid";
perPage = 200;
maxInterestInvoicesPerRun = 25;
retryMaxAttempts = 3;
maxLogLinesToKeep = 25;
debugMode = false;
debugMaxRowsToExplain = 50;
// -------------------- VALIDATION --------------------
validationErrors = List();
if(interestInvoicePrefix == "")
{
	validationErrors.add("Missing interestInvoicePrefix.");
}
if(interestInvoiceNumberDigits <= 0)
{
	validationErrors.add("interestInvoiceNumberDigits must be greater than zero.");
}
if(interestItemId == "" || interestItemId.contains("CONFIG_REQUIRED"))
{
	validationErrors.add("Missing interestItemId for delinquent rent interest.");
}
if(stagesFieldApiName == "")
{
	validationErrors.add("Missing stagesFieldApiName.");
}
if(rentInvoiceFlagApiName == "")
{
	validationErrors.add("Missing rentInvoiceFlagApiName.");
}
if(interestAprPct <= 0)
{
	validationErrors.add("interestAprPct must be greater than zero.");
}
if(interestFirstEligibleDaysAfterDue <= 30)
{
	validationErrors.add("interestFirstEligibleDaysAfterDue must be greater than 30 to match Lease Section 3.6 eligibility.");
}
if(interestStartsDaysAfterDue < 0)
{
	validationErrors.add("interestStartsDaysAfterDue cannot be negative.");
}
if(validationErrors.size() > 0)
{
	for each  validationError in validationErrors
	{
		info "ERROR: " + validationError;
	}
	return;
}
// -------------------- ITERATORS --------------------
ITER_3 = List();
ITER_3.add(1);
ITER_3.add(2);
ITER_3.add(3);
ITER_12 = List();
ITER_12.add(1);
ITER_12.add(2);
ITER_12.add(3);
ITER_12.add(4);
ITER_12.add(5);
ITER_12.add(6);
ITER_12.add(7);
ITER_12.add(8);
ITER_12.add(9);
ITER_12.add(10);
ITER_12.add(11);
ITER_12.add(12);
// -------------------- CACHES AND COUNTERS --------------------
customerCache = Map();
emailTemplateCache = Map();
customerInterestRows = Map();
customerIdsWithInterestRows = List();
customerPeriodDuplicateCache = Map();
runWarnings = List();
scannedInvoicesCount = 0;
eligibleRentInvoicesCount = 0;
interestRowsPreparedCount = 0;
createdInterestInvoicesCount = 0;
emailedInterestInvoicesCount = 0;
debugExplainCount = 0;
if(interestInvoiceEmailTemplateName != "" && interestInvoiceEmailTemplateId != "")
{
	emailTemplateCache.put(interestInvoiceEmailTemplateName.toLowerCase(),interestInvoiceEmailTemplateId);
}
// Best-effort email template lookup. If this fails, Zoho Books default invoice email is used.
if(interestInvoiceEmailTemplateName != "" && interestInvoiceEmailTemplateId == "")
{
	for each  templateAttempt in ITER_3
	{
		try 
		{
			templateParams = Map();
			templateParams.put("organization_id",orgId);
			templateResponse = invokeurl
			[
				url :apiBase + "/settings/emailtemplates"
				type :GET
				parameters:templateParams
				connection:"zbooks"
			];
			templateRows = List();
			if(templateResponse != null && templateResponse.get("email_templates") != null)
			{
				templateRows = templateResponse.get("email_templates");
			}
			if(templateRows != null && templateRows.size() > 0)
			{
				for each  templateRow in templateRows
				{
					templateName = ifnull(templateRow.get("name"),"").toString().trim();
					templateId = ifnull(templateRow.get("email_template_id"),"").toString().trim();
					if(templateName != "" && templateId != "")
					{
						emailTemplateCache.put(templateName.toLowerCase(),templateId);
					}
				}
			}
			break;
		}
		catch (templateError)
		{
			// Non-fatal. Email can still use the default Books invoice template.
		}
	}
}
// -------------------- NEXT INT INVOICE NUMBER --------------------
interestSeq = 1;
interestInvoiceTemplateId = "";
seriesParams = Map();
seriesParams.put("organization_id",orgId);
seriesParams.put("invoice_number_startswith",interestInvoicePrefix);
seriesParams.put("sort_column","invoice_number");
seriesParams.put("sort_order","D");
seriesParams.put("per_page",1);
seriesParams.put("page",1);
seriesResponse = invokeurl
[
	url :apiBase + "/invoices"
	type :GET
	parameters:seriesParams
	connection:"zbooks"
];
if(seriesResponse != null && seriesResponse.get("invoices") != null && seriesResponse.get("invoices").size() > 0)
{
	lastInterestInvoice = seriesResponse.get("invoices").get(0);
	lastInterestInvoiceNumber = ifnull(lastInterestInvoice.get("invoice_number"),"").toString();
	lastInterestInvoiceId = ifnull(lastInterestInvoice.get("invoice_id"),"").toString();
	if(lastInterestInvoiceNumber != "")
	{
		seqString = lastInterestInvoiceNumber.remove(interestInvoicePrefix).trim();
		try 
		{
			interestSeq = seqString.toLong() + 1;
		}
		catch (seqError)
		{
			interestSeq = 1;
		}
	}
	if(lastInterestInvoiceId != "")
	{
		try 
		{
			detailParamsForTemplate = Map();
			detailParamsForTemplate.put("organization_id",orgId);
			lastDetailResponse = invokeurl
			[
				url :apiBase + "/invoices/" + lastInterestInvoiceId
				type :GET
				parameters:detailParamsForTemplate
				connection:"zbooks"
			];
			if(lastDetailResponse != null && lastDetailResponse.get("invoice") != null)
			{
				interestInvoiceTemplateId = ifnull(lastDetailResponse.get("invoice").get("template_id"),"").toString();
			}
		}
		catch (lastTemplateError)
		{
			interestInvoiceTemplateId = "";
		}
	}
}
seqText = interestSeq.toString();
padCount = interestInvoiceNumberDigits - seqText.length();
if(padCount > 0)
{
	for each  padStep in ITER_12
	{
		if(padStep > padCount)
		{
			break;
		}
		seqText = "0" + seqText;
	}
}
nextInterestInvoiceNumber = interestInvoicePrefix + seqText;
// -------------------- FETCH CANDIDATE INVOICES --------------------
// One page is intentional for GHRE scale and avoids a Zoho Books schedule parser issue with paging loops.
listParams = Map();
listParams.put("organization_id",orgId);
listParams.put("filter_by",invoiceListFilterBy);
listParams.put("sort_column","due_date");
listParams.put("sort_order","A");
listParams.put("per_page",perPage);
listParams.put("page",1);
invoicesResponse = invokeurl
[
	url :apiBase + "/invoices"
	type :GET
	parameters:listParams
	connection:"zbooks"
];
candidateInvoices = List();
if(invoicesResponse != null && invoicesResponse.get("invoices") != null)
{
	candidateInvoices = invoicesResponse.get("invoices");
}
if(candidateInvoices == null || candidateInvoices.size() == 0)
{
	if(debugMode)
	{
		info "Monthly Interest Billing completed. No unpaid invoices returned.";
	}
	return;
}
// -------------------- PREPARE INTEREST ROWS --------------------
for each  invoiceSummary in candidateInvoices
{
	invoiceId = ifnull(invoiceSummary.get("invoice_id"),"").toString();
	invoiceNumber = ifnull(invoiceSummary.get("invoice_number"),"").toString();
	invoiceReferenceNumber = ifnull(invoiceSummary.get("reference_number"),"").toString().trim();
	customerId = ifnull(invoiceSummary.get("customer_id"),"").toString();
	balanceDue = ifnull(invoiceSummary.get("balance"),0).toDecimal();
	dueDateString = ifnull(invoiceSummary.get("due_date"),"").toString();
	if(invoiceId == "" || customerId == "" || dueDateString == "")
	{
		continue;
	}
	scannedInvoicesCount = scannedInvoicesCount + 1;
	if(balanceDue <= 0)
	{
		continue;
	}
	if(invoiceNumber != "" && (invoiceNumber.indexOf("LF-") == 0 || invoiceNumber.indexOf("RF-") == 0 || invoiceNumber.indexOf(interestInvoicePrefix) == 0))
	{
		continue;
	}
	dueDate = null;
	try 
	{
		dueDate = dueDateString.toDate("yyyy-MM-dd");
	}
	catch (dueDateError)
	{
		continue;
	}
	firstEligibleDate = dueDate.addDay(interestFirstEligibleDaysAfterDue);
	if(today < firstEligibleDate)
	{
		continue;
	}
	customerPeriodReference = "GHRE_INT_" + periodKey + "_" + customerId;
	customerAlreadyBilledThisPeriod = false;
	if(customerPeriodDuplicateCache.containsKey(customerPeriodReference))
	{
		customerAlreadyBilledThisPeriod = ifnull(customerPeriodDuplicateCache.get(customerPeriodReference),false);
	}
	else
	{
		try 
		{
			periodSearchParams = Map();
			periodSearchParams.put("organization_id",orgId);
			periodSearchParams.put("customer_id",customerId);
			periodSearchParams.put("search_text",customerPeriodReference);
			periodSearchParams.put("filter_by","Status.All");
			periodSearchParams.put("per_page",200);
			periodSearchResponse = invokeurl
			[
				url :apiBase + "/invoices"
				type :GET
				parameters:periodSearchParams
				connection:"zbooks"
			];
			periodInvoices = List();
			if(periodSearchResponse != null && periodSearchResponse.get("invoices") != null)
			{
				periodInvoices = periodSearchResponse.get("invoices");
			}
			if(periodInvoices != null && periodInvoices.size() > 0)
			{
				for each  periodInvoice in periodInvoices
				{
					periodStatus = ifnull(periodInvoice.get("status"),"").toString().toLowerCase();
					periodReference = ifnull(periodInvoice.get("reference_number"),"").toString();
					if(periodReference == customerPeriodReference && periodStatus != "void" && periodStatus != "deleted")
					{
						customerAlreadyBilledThisPeriod = true;
						break;
					}
				}
			}
		}
		catch (periodSearchError)
		{
			// Source-invoice tokens remain the second duplicate guard if search has a transient failure.
		}
		customerPeriodDuplicateCache.put(customerPeriodReference,customerAlreadyBilledThisPeriod);
	}
	if(customerAlreadyBilledThisPeriod)
	{
		continue;
	}
	detailInvoice = null;
	customFields = invoiceSummary.get("custom_fields");
	sourceInvoiceTemplateId = ifnull(invoiceSummary.get("template_id"),"").toString();
	sourcePaymentOptions = invoiceSummary.get("payment_options");
	sourceAllowPartialPaymentsObj = invoiceSummary.get("allow_partial_payments");
	invoiceAchPaymentInitiatedObj = invoiceSummary.get("ach_payment_initiated");
	for each  detailAttempt in ITER_3
	{
		try 
		{
			detailParams = Map();
			detailParams.put("organization_id",orgId);
			detailResponse = invokeurl
			[
				url :apiBase + "/invoices/" + invoiceId
				type :GET
				parameters:detailParams
				connection:"zbooks"
			];
			if(detailResponse != null && detailResponse.get("invoice") != null)
			{
				detailInvoice = detailResponse.get("invoice");
				customFields = detailInvoice.get("custom_fields");
				sourceInvoiceTemplateId = ifnull(detailInvoice.get("template_id"),sourceInvoiceTemplateId).toString();
				sourcePaymentOptions = detailInvoice.get("payment_options");
				sourceAllowPartialPaymentsObj = detailInvoice.get("allow_partial_payments");
				invoiceAchPaymentInitiatedObj = detailInvoice.get("ach_payment_initiated");
				invoiceReferenceNumber = ifnull(detailInvoice.get("reference_number"),invoiceReferenceNumber).toString().trim();
				break;
			}
		}
		catch (detailError)
		{
			detailInvoice = null;
		}
	}
	if(detailInvoice == null)
	{
		continue;
	}
	invoiceStatus = ifnull(detailInvoice.get("status"),ifnull(invoiceSummary.get("status"),"")).toString().toLowerCase();
	if(invoiceStatus == "draft" || invoiceStatus == "void" || invoiceStatus == "deleted")
	{
		continue;
	}
	feeOnlyInvoiceDetected = false;
	invoiceIdentityLow = (invoiceNumber + " " + invoiceReferenceNumber).toLowerCase();
	if(invoiceIdentityLow.contains("ghre_int_") || invoiceIdentityLow.contains("monthly interest") || invoiceIdentityLow.contains("delinquent rent interest") || invoiceIdentityLow.contains("late fee") || invoiceIdentityLow.contains("returned payment") || invoiceIdentityLow.contains("returned check") || invoiceIdentityLow.contains("nsf") || invoiceIdentityLow.contains("processing fee") || invoiceIdentityLow.contains("online payment fee") || invoiceIdentityLow.contains("application fee") || invoiceIdentityLow.contains("security deposit"))
	{
		feeOnlyInvoiceDetected = true;
	}
	lineItems = List();
	if(detailInvoice.get("line_items") != null)
	{
		lineItems = detailInvoice.get("line_items");
	}
	if(!feeOnlyInvoiceDetected && lineItems != null && lineItems.size() > 0)
	{
		for each  lineItem in lineItems
		{
			lineNameLow = ifnull(lineItem.get("name"),"").toString().toLowerCase();
			lineDescLow = ifnull(lineItem.get("description"),"").toString().toLowerCase();
			lineTextLow = lineNameLow + " " + lineDescLow;
			if(lineTextLow.contains("monthly interest") || lineTextLow.contains("delinquent rent interest") || lineTextLow.contains("late fee") || lineTextLow.contains("returned payment") || lineTextLow.contains("returned check") || lineTextLow.contains("nsf") || lineTextLow.contains("processing fee") || lineTextLow.contains("online payment fee") || lineTextLow.contains("application fee") || lineTextLow.contains("security deposit"))
			{
				feeOnlyInvoiceDetected = true;
				break;
			}
		}
	}
	if(feeOnlyInvoiceDetected)
	{
		continue;
	}
	invoiceAchPaymentInitiated = false;
	if(invoiceAchPaymentInitiatedObj == true || ifnull(invoiceAchPaymentInitiatedObj,"").toString().toLowerCase() == "true")
	{
		invoiceAchPaymentInitiated = true;
	}
	if(invoiceAchPaymentInitiated)
	{
		continue;
	}
	isRentInvoice = false;
	invoiceDoNotAssess = false;
	invoiceFeeExempt = false;
	invoiceFeeExemptUntil = null;
	stageFieldRaw = "";
	stageFieldCustomFieldId = "";
	if(customFields != null)
	{
		for each  customField in customFields
		{
			customFieldApi = ifnull(customField.get("api_name"),"").toString();
			customFieldValueObj = customField.get("value");
			customFieldValue = ifnull(customFieldValueObj,"").toString().trim();
			customFieldValueLow = customFieldValue.toLowerCase();
			if(customFieldApi == stagesFieldApiName)
			{
				stageFieldRaw = customFieldValue;
				if(customField.get("customfield_id") != null)
				{
					stageFieldCustomFieldId = customField.get("customfield_id").toString();
				}
				continue;
			}
			if(customFieldApi == rentInvoiceFlagApiName)
			{
				if(customFieldValueObj == true || customFieldValueLow == "true" || customFieldValueLow == "yes" || customFieldValueLow == "1")
				{
					isRentInvoice = true;
				}
				continue;
			}
			if(customFieldApi == invoiceDoNotAssessApiName)
			{
				if(customFieldValueObj == true || customFieldValueLow == "true" || customFieldValueLow == "yes" || customFieldValueLow == "1")
				{
					invoiceDoNotAssess = true;
				}
				continue;
			}
			if(customFieldApi == invoiceFeeExemptApiName)
			{
				if(customFieldValueObj == true || customFieldValueLow == "true" || customFieldValueLow == "yes" || customFieldValueLow == "1")
				{
					invoiceFeeExempt = true;
				}
				continue;
			}
			if(customFieldApi == invoiceFeeExemptUntilApiName && customFieldValue != "")
			{
				try 
				{
					datePart = customFieldValue;
					if(customFieldValue.indexOf("T") > 0)
					{
						datePart = customFieldValue.toList("T").get(0).toString();
					}
					invoiceFeeExemptUntil = datePart.toDate("yyyy-MM-dd");
				}
				catch (invoiceExemptDateError)
				{
					invoiceFeeExemptUntil = null;
				}
				continue;
			}
		}
	}
	if(!isRentInvoice)
	{
		continue;
	}
	eligibleRentInvoicesCount = eligibleRentInvoicesCount + 1;
	if(invoiceDoNotAssess || invoiceFeeExempt)
	{
		continue;
	}
	if(invoiceFeeExemptUntil != null && today <= invoiceFeeExemptUntil)
	{
		continue;
	}
	customerExempt = false;
	customerExemptUntil = null;
	if(customerCache.containsKey(customerId))
	{
		customerControl = customerCache.get(customerId);
		customerExempt = ifnull(customerControl.get("exempt"),false);
		customerExemptUntil = customerControl.get("until");
	}
	else
	{
		try 
		{
			contactResponse = invokeurl
			[
				url :apiBase + "/contacts/" + customerId + "?organization_id=" + orgId
				type :GET
				connection:"zbooks"
			];
			contactMap = null;
			contactFields = List();
			if(contactResponse != null && contactResponse.get("contact") != null)
			{
				contactMap = contactResponse.get("contact");
				if(contactMap.get("custom_fields") != null)
				{
					contactFields = contactMap.get("custom_fields");
				}
			}
			if(contactFields != null && contactFields.size() > 0)
			{
				for each  contactField in contactFields
				{
					contactFieldApi = ifnull(contactField.get("api_name"),"").toString();
					contactFieldValue = ifnull(contactField.get("value"),"").toString().trim();
					contactFieldValueLow = contactFieldValue.toLowerCase();
					if(contactFieldApi == customerFeeExemptApiName && (contactFieldValueLow == "true" || contactFieldValueLow == "yes" || contactFieldValueLow == "1"))
					{
						customerExempt = true;
					}
					if(contactFieldApi == customerFeeExemptUntilApiName && contactFieldValue != "")
					{
						try 
						{
							customerExemptUntil = contactFieldValue.toDate("yyyy-MM-dd");
						}
						catch (contactDateError)
						{
							customerExemptUntil = null;
						}
					}
				}
			}
		}
		catch (contactError)
		{
			customerExempt = false;
			customerExemptUntil = null;
		}
		customerControlNew = Map();
		customerControlNew.put("exempt",customerExempt);
		customerControlNew.put("until",customerExemptUntil);
		customerCache.put(customerId,customerControlNew);
	}
	if(customerExempt || (customerExemptUntil != null && today <= customerExemptUntil))
	{
		continue;
	}
	// Parse source invoice tokens.
	tokenCsv = "";
	logLines = List();
	foundTokensLine = false;
	if(stageFieldRaw != "" && (stageFieldRaw.indexOf("\n") >= 0 || stageFieldRaw.indexOf("TOKENS=") >= 0))
	{
		stageLines = stageFieldRaw.toList("\n");
		for each  stageLine in stageLines
		{
			stageLineText = stageLine.toString().trim();
			if(stageLineText == "")
			{
				continue;
			}
			if(stageLineText.indexOf("TOKENS=") == 0)
			{
				tokenCsv = stageLineText.remove("TOKENS=").trim();
				foundTokensLine = true;
				continue;
			}
			if(stageLineText.indexOf("LOG:") == 0)
			{
				logLines.add(stageLineText);
				continue;
			}
		}
	}
	if(!foundTokensLine)
	{
		tokenCsv = stageFieldRaw;
		if(tokenCsv.indexOf("\n") >= 0)
		{
			tokenCsv = tokenCsv.replaceAll("\n",",");
		}
	}
	tokens = List();
	if(tokenCsv != "")
	{
		tokens = tokenCsv.toList(",");
	}
	baseTokens = List();
	interestLastThroughDate = null;
	interestTotalCharged = 0.0;
	sourceAlreadyBilledThisPeriod = false;
	for each  tokenObj in tokens
	{
		tokenText = tokenObj.toString().trim();
		if(tokenText == "")
		{
			continue;
		}
		if(tokenText == periodToken)
		{
			sourceAlreadyBilledThisPeriod = true;
			baseTokens.add(tokenText);
			continue;
		}
		if(tokenText.indexOf(interestInvoiceIdTokenPrefix + periodKey) == 0)
		{
			sourceAlreadyBilledThisPeriod = true;
			baseTokens.add(tokenText);
			continue;
		}
		if(tokenText.indexOf(interestLastThroughTokenPrefix) == 0)
		{
			lastThroughText = tokenText.remove(interestLastThroughTokenPrefix).trim();
			try 
			{
				lastThroughDateCandidate = lastThroughText.toDate("yyyy-MM-dd");
				if(interestLastThroughDate == null || lastThroughDateCandidate > interestLastThroughDate)
				{
					interestLastThroughDate = lastThroughDateCandidate;
				}
			}
			catch (lastThroughParseError)
			{
				interestLastThroughDate = null;
			}
			continue;
		}
		if(tokenText.indexOf(interestTotalTokenPrefix) == 0)
		{
			interestTotalText = tokenText.remove(interestTotalTokenPrefix).trim();
			try 
			{
				interestTotalCharged = interestTotalText.toDecimal();
			}
			catch (interestTotalParseError)
			{
				interestTotalCharged = 0.0;
			}
			continue;
		}
		baseTokens.add(tokenText);
	}
	if(sourceAlreadyBilledThisPeriod)
	{
		continue;
	}
	defaultInterestStartDate = dueDate.addDay(interestStartsDaysAfterDue);
	interestStartDate = defaultInterestStartDate;
	if(interestLastThroughDate != null && interestLastThroughDate > interestStartDate)
	{
		interestStartDate = interestLastThroughDate;
	}
	if(interestStartDate >= interestThroughDate)
	{
		continue;
	}
	interestDays = 0;
	try 
	{
		interestDays = interestStartDate.daysBetween(interestThroughDate);
	}
	catch (interestDaysError)
	{
		interestDays = 0;
	}
	if(interestDays <= 0)
	{
		continue;
	}
	interestAmount = (balanceDue * interestAprPct / 100.0 * interestDays / 365.0).round(2);
	if(interestAmount <= 0)
	{
		continue;
	}
	row = Map();
	row.put("customer_id",customerId);
	row.put("source_invoice_id",invoiceId);
	row.put("source_invoice_number",invoiceNumber);
	row.put("source_balance",balanceDue);
	row.put("interest_start",interestStartDate.toString("yyyy-MM-dd"));
	row.put("interest_through",interestThroughDateString);
	row.put("interest_days",interestDays);
	row.put("interest_amount",interestAmount);
	row.put("source_template_id",sourceInvoiceTemplateId);
	row.put("source_payment_options",sourcePaymentOptions);
	row.put("source_allow_partial_payments",sourceAllowPartialPaymentsObj);
	row.put("stage_field_customfield_id",stageFieldCustomFieldId);
	row.put("base_tokens",baseTokens);
	row.put("log_lines",logLines);
	row.put("interest_total_charged",interestTotalCharged);
	if(customerInterestRows.containsKey(customerId))
	{
		customerRows = customerInterestRows.get(customerId);
	}
	else
	{
		customerRows = List();
		customerIdsWithInterestRows.add(customerId);
	}
	customerRows.add(row);
	customerInterestRows.put(customerId,customerRows);
	interestRowsPreparedCount = interestRowsPreparedCount + 1;
}
// -------------------- CREATE CONSOLIDATED INTEREST INVOICES --------------------
for each  customerIdKey in customerIdsWithInterestRows
{
	if(createdInterestInvoicesCount >= maxInterestInvoicesPerRun)
	{
		break;
	}
	rowsForCustomer = customerInterestRows.get(customerIdKey);
	if(rowsForCustomer == null || rowsForCustomer.size() == 0)
	{
		continue;
	}
	customerPeriodReference = "GHRE_INT_" + periodKey + "_" + customerIdKey;
	alreadyExists = false;
	try 
	{
		duplicateParams = Map();
		duplicateParams.put("organization_id",orgId);
		duplicateParams.put("customer_id",customerIdKey);
		duplicateParams.put("search_text",customerPeriodReference);
		duplicateParams.put("filter_by","Status.All");
		duplicateParams.put("per_page",200);
		duplicateResponse = invokeurl
		[
			url :apiBase + "/invoices"
			type :GET
			parameters:duplicateParams
			connection:"zbooks"
		];
		duplicateInvoices = List();
		if(duplicateResponse != null && duplicateResponse.get("invoices") != null)
		{
			duplicateInvoices = duplicateResponse.get("invoices");
		}
		if(duplicateInvoices != null && duplicateInvoices.size() > 0)
		{
			for each  existingInvoice in duplicateInvoices
			{
				existingReference = ifnull(existingInvoice.get("reference_number"),"").toString();
				existingStatus = ifnull(existingInvoice.get("status"),"").toString().toLowerCase();
				if(existingReference == customerPeriodReference && existingStatus != "void" && existingStatus != "deleted")
				{
					alreadyExists = true;
					break;
				}
			}
		}
	}
	catch (duplicateSearchError)
	{
		warnDuplicate = "WARN: Duplicate search failed for " + customerPeriodReference + ": " + duplicateSearchError.toString();
		info warnDuplicate;
		runWarnings.add(warnDuplicate);
		continue;
	}
	if(alreadyExists)
	{
		continue;
	}
	invoiceLines = List();
	totalInterestForCustomer = 0.0;
	invoiceTemplateToUse = interestInvoiceTemplateId;
	paymentOptionsToUse = null;
	firstRow = rowsForCustomer.get(0);
	allowPartialPaymentsToUse = firstRow.get("source_allow_partial_payments");
	if(inheritSourceInvoicePdfTemplate && ifnull(firstRow.get("source_template_id"),"").toString() != "")
	{
		invoiceTemplateToUse = firstRow.get("source_template_id").toString();
	}
	if(inheritSourceInvoicePaymentOptions && firstRow.get("source_payment_options") != null)
	{
		paymentOptionsToUse = firstRow.get("source_payment_options");
	}
	for each  interestRow in rowsForCustomer
	{
		interestAmountRow = ifnull(interestRow.get("interest_amount"),0).toDecimal();
		if(interestAmountRow <= 0)
		{
			continue;
		}
		totalInterestForCustomer = (totalInterestForCustomer + interestAmountRow).round(2);
		lineItem = Map();
		lineItem.put("item_id",interestItemId);
		lineItem.put("quantity",1);
		lineItem.put("rate",interestAmountRow);
		lineDescription = "Simple delinquent-rent interest for rent invoice ";
		lineDescription = lineDescription + interestRow.get("source_invoice_number").toString();
		lineDescription = lineDescription + " at " + interestAprPct.toString() + "% APR. ";
		lineDescription = lineDescription + "Lease Section 3.6 eligibility begins after more than 30 days delinquent; once eligible, interest accrues from the original due date. ";
		lineDescription = lineDescription + "Interest period: " + interestRow.get("interest_start").toString();
		lineDescription = lineDescription + " through " + interestRow.get("interest_through").toString();
		lineDescription = lineDescription + " (" + interestRow.get("interest_days").toString() + " days). ";
		lineDescription = lineDescription + "Interest is not compounded and is not charged on fees.";
		lineItem.put("description",lineDescription);
		invoiceLines.add(lineItem);
	}
	if(invoiceLines.size() == 0 || totalInterestForCustomer <= 0)
	{
		continue;
	}
	if(totalInterestForCustomer < interestMinimumInvoiceAmount)
	{
		if(debugMode && debugExplainCount < debugMaxRowsToExplain)
		{
			info "NO-ACTION: customer " + customerIdKey + " interest below minimum.";
			debugExplainCount = debugExplainCount + 1;
		}
		continue;
	}
	invoicePayload = Map();
	invoicePayload.put("customer_id",customerIdKey);
	invoicePayload.put("date",interestThroughDateString);
	invoicePayload.put("due_date",interestThroughDateString);
	invoicePayload.put("invoice_number",nextInterestInvoiceNumber);
	invoicePayload.put("reference_number",customerPeriodReference);
	if(allowPartialPaymentsToUse != null)
	{
		invoicePayload.put("allow_partial_payments",allowPartialPaymentsToUse);
	}
	if(invoiceTemplateToUse != "")
	{
		invoicePayload.put("template_id",invoiceTemplateToUse);
	}
	if(paymentOptionsToUse != null)
	{
		invoicePayload.put("payment_options",paymentOptionsToUse);
	}
	invoicePayload.put("line_items",invoiceLines);
	invoicePayload.put("notes","Monthly delinquent-rent interest. This invoice is generated only for unpaid rent balances older than the configured delinquency period. Interest is simple, not compounded, and is not charged on fees.");
	createResponse = null;
	for each  createAttempt in ITER_3
	{
		try 
		{
			createResponse = invokeurl
			[
				url :apiBase + "/invoices?organization_id=" + orgId + "&ignore_auto_number_generation=true"
				type :POST
				parameters:{"JSONString":invoicePayload.toString()}
				connection:"zbooks"
			];
			if(createResponse != null && createResponse.get("invoice") == null)
			{
				createMessage = ifnull(createResponse.get("message"),"").toString().toLowerCase();
				if(createMessage.contains("invoice") && createMessage.contains("number") && (createMessage.contains("exist") || createMessage.contains("duplicate") || createMessage.contains("already")))
				{
					interestSeq = interestSeq + 1;
					seqTmp = interestSeq.toString();
					padTmp = interestInvoiceNumberDigits - seqTmp.length();
					if(padTmp > 0)
					{
						for each  padTmpStep in ITER_12
						{
							if(padTmpStep > padTmp)
							{
								break;
							}
							seqTmp = "0" + seqTmp;
						}
					}
					nextInterestInvoiceNumber = interestInvoicePrefix + seqTmp;
					invoicePayload.put("invoice_number",nextInterestInvoiceNumber);
					continue;
				}
			}
			if(createResponse != null && createResponse.get("invoice") != null)
			{
				break;
			}
		}
		catch (createError)
		{
			createResponse = null;
		}
	}
	if(createResponse == null || createResponse.get("invoice") == null)
	{
		warnCreate = "WARN/ALERT: Failed to create monthly interest invoice for customer " + customerIdKey;
		info warnCreate;
		runWarnings.add(warnCreate);
		continue;
	}
	newInterestInvoiceId = ifnull(createResponse.get("invoice").get("invoice_id"),"").toString();
	createdInterestInvoicesCount = createdInterestInvoicesCount + 1;
	// Ensure online payments are available on the interest invoice.
	if(enableOnlinePaymentsForInterestInvoices && newInterestInvoiceId != "")
	{
		try 
		{
			existingGatewayCount = 0;
			createdInvoiceResponse = invokeurl
			[
				url :apiBase + "/invoices/" + newInterestInvoiceId + "?organization_id=" + orgId
				type :GET
				connection:"zbooks"
			];
			if(createdInvoiceResponse != null && createdInvoiceResponse.get("invoice") != null)
			{
				createdPaymentOptions = createdInvoiceResponse.get("invoice").get("payment_options");
				if(createdPaymentOptions != null && createdPaymentOptions.get("payment_gateways") != null)
				{
					existingGatewayCount = createdPaymentOptions.get("payment_gateways").size();
				}
			}
			desiredPaymentOptions = null;
			if(paymentOptionsToUse != null && paymentOptionsToUse.get("payment_gateways") != null && paymentOptionsToUse.get("payment_gateways").size() > 0)
			{
				desiredPaymentOptions = paymentOptionsToUse;
			}
			else if(forcePaymentGatewayName != "")
			{
				desiredPaymentOptions = Map();
				paymentGateways = List();
				paymentGateway = Map();
				paymentGateway.put("configured",true);
				paymentGateway.put("gateway_name",forcePaymentGatewayName);
				paymentGateways.add(paymentGateway);
				desiredPaymentOptions.put("payment_gateways",paymentGateways);
			}
			if(existingGatewayCount == 0 && desiredPaymentOptions != null)
			{
				paymentUpdatePayload = Map();
				if(allowPartialPaymentsToUse != null)
				{
					paymentUpdatePayload.put("allow_partial_payments",allowPartialPaymentsToUse);
				}
				paymentUpdatePayload.put("payment_options",desiredPaymentOptions);
				paymentUpdateResponse = invokeurl
				[
					url :apiBase + "/invoices/" + newInterestInvoiceId + "?organization_id=" + orgId
					type :PUT
					parameters:{"JSONString":paymentUpdatePayload.toString()}
					connection:"zbooks"
				];
			}
		}
		catch (paymentOptionError)
		{
			warnPaymentOption = "WARN: Payment option update failed for interest invoice " + newInterestInvoiceId;
			info warnPaymentOption;
			runWarnings.add(warnPaymentOption);
		}
	}
	// Email the invoice.
	if(autoEmailInterestInvoices && newInterestInvoiceId != "")
	{
		try 
		{
			templateIdToUse = "";
			if(interestInvoiceEmailTemplateName != "" && emailTemplateCache.containsKey(interestInvoiceEmailTemplateName.toLowerCase()))
			{
				templateIdToUse = emailTemplateCache.get(interestInvoiceEmailTemplateName.toLowerCase());
			}
			emailGetUrl = apiBase + "/invoices/" + newInterestInvoiceId + "/email?organization_id=" + orgId;
			if(templateIdToUse != "")
			{
				emailGetUrl = emailGetUrl + "&email_template_id=" + templateIdToUse;
			}
			emailGetResponse = invokeurl
			[
				url :emailGetUrl
				type :GET
				connection:"zbooks"
			];
			toMailIds = List();
			emailSubject = "";
			emailBody = "";
			if(emailGetResponse != null && emailGetResponse.get("data") != null)
			{
				if(emailGetResponse.get("data").get("to_mail_ids") != null)
				{
					toMailIds = emailGetResponse.get("data").get("to_mail_ids");
				}
				emailSubject = ifnull(emailGetResponse.get("data").get("subject"),"").toString();
				emailBody = ifnull(emailGetResponse.get("data").get("body"),"").toString();
			}
			if((toMailIds == null || toMailIds.size() == 0) && enableRecipientFallbackToCustomerEmail)
			{
				contactEmailResponse = invokeurl
				[
					url :apiBase + "/contacts/" + customerIdKey + "?organization_id=" + orgId
					type :GET
					connection:"zbooks"
				];
				fallbackEmails = List();
				seenEmails = Map();
				contactEmailMap = null;
				contactPersons = List();
				if(contactEmailResponse != null && contactEmailResponse.get("contact") != null)
				{
					contactEmailMap = contactEmailResponse.get("contact");
					contactEmail = ifnull(contactEmailMap.get("email"),"").toString().trim();
					if(contactEmail != "" && !seenEmails.containsKey(contactEmail))
					{
						fallbackEmails.add(contactEmail);
						seenEmails.put(contactEmail,true);
					}
					if(contactEmailMap.get("contact_persons") != null)
					{
						contactPersons = contactEmailMap.get("contact_persons");
					}
					if(contactPersons != null && contactPersons.size() > 0)
					{
						for each  contactPerson in contactPersons
						{
							personEmail = ifnull(contactPerson.get("email"),"").toString().trim();
							if(personEmail != "" && !seenEmails.containsKey(personEmail))
							{
								fallbackEmails.add(personEmail);
								seenEmails.put(personEmail,true);
							}
						}
					}
				}
				if(fallbackEmails.size() > 0)
				{
					toMailIds = fallbackEmails;
				}
			}
			if(toMailIds != null && toMailIds.size() > 0)
			{
				if(markInvoicesAsSentBeforeEmail)
				{
					try 
					{
						markSentResponse = invokeurl
						[
							url :apiBase + "/invoices/" + newInterestInvoiceId + "/status/sent?organization_id=" + orgId
							type :POST
							connection:"zbooks"
						];
					}
					catch (markSentError)
					{
						info "WARN: Mark-as-sent failed for interest invoice " + newInterestInvoiceId;
					}
				}
				emailPayload = Map();
				emailPayload.put("send_from_org_email_id",true);
				emailPayload.put("to_mail_ids",toMailIds);
				if(emailSubject != "")
				{
					emailPayload.put("subject",emailSubject);
				}
				if(emailBody != "")
				{
					emailPayload.put("body",emailBody);
				}
				emailSendResponse = invokeurl
				[
					url :apiBase + "/invoices/" + newInterestInvoiceId + "/email?organization_id=" + orgId
					type :POST
					parameters:{"JSONString":emailPayload.toString()}
					connection:"zbooks"
				];
				if(emailSendResponse != null && emailSendResponse.get("code") != null && emailSendResponse.get("code").toString() == "0")
				{
					emailedInterestInvoicesCount = emailedInterestInvoicesCount + 1;
				}
			}
		}
		catch (emailError)
		{
			warnEmail = "WARN: Email failed for monthly interest invoice " + newInterestInvoiceId;
			info warnEmail;
			runWarnings.add(warnEmail);
		}
	}
	// Persist interest tokens to each source rent invoice after the interest invoice is created.
	for each  interestRowToPersist in rowsForCustomer
	{
		sourceInvoiceId = interestRowToPersist.get("source_invoice_id").toString();
		sourceInvoiceNumber = interestRowToPersist.get("source_invoice_number").toString();
		sourceStageFieldCustomFieldId = ifnull(interestRowToPersist.get("stage_field_customfield_id"),"").toString();
		sourceAllowPartialPaymentsPersist = interestRowToPersist.get("source_allow_partial_payments");
		baseTokensPersist = interestRowToPersist.get("base_tokens");
		logLinesPersist = interestRowToPersist.get("log_lines");
		interestTotalPrior = ifnull(interestRowToPersist.get("interest_total_charged"),0).toDecimal();
		interestAmountForSource = ifnull(interestRowToPersist.get("interest_amount"),0).toDecimal();
		interestTotalNew = (interestTotalPrior + interestAmountForSource).round(2);
		allTokens = List();
		seenTokens = Map();
		if(baseTokensPersist != null)
		{
			for each  baseTokenObj in baseTokensPersist
			{
				baseTokenText = baseTokenObj.toString().trim();
				if(baseTokenText != "" && !seenTokens.containsKey(baseTokenText))
				{
					allTokens.add(baseTokenText);
					seenTokens.put(baseTokenText,true);
				}
			}
		}
		if(!seenTokens.containsKey(periodToken))
		{
			allTokens.add(periodToken);
			seenTokens.put(periodToken,true);
		}
		intInvoiceToken = interestInvoiceIdTokenPrefix + periodKey + "=" + newInterestInvoiceId;
		if(!seenTokens.containsKey(intInvoiceToken))
		{
			allTokens.add(intInvoiceToken);
			seenTokens.put(intInvoiceToken,true);
		}
		intThroughToken = interestLastThroughTokenPrefix + interestThroughDateString;
		if(!seenTokens.containsKey(intThroughToken))
		{
			allTokens.add(intThroughToken);
			seenTokens.put(intThroughToken,true);
		}
		intTotalToken = interestTotalTokenPrefix + interestTotalNew.toString();
		if(!seenTokens.containsKey(intTotalToken))
		{
			allTokens.add(intTotalToken);
			seenTokens.put(intTotalToken,true);
		}
		lastBalanceToken = lastBalanceTokenPrefix + interestRowToPersist.get("source_balance").toString();
		if(!seenTokens.containsKey(lastBalanceToken))
		{
			allTokens.add(lastBalanceToken);
			seenTokens.put(lastBalanceToken,true);
		}
		tokenCsvOut = "";
		for each  tokenOut in allTokens
		{
			if(tokenCsvOut != "")
			{
				tokenCsvOut = tokenCsvOut + ",";
			}
			tokenCsvOut = tokenCsvOut + tokenOut.toString();
		}
		stageWrite = "TOKENS=" + tokenCsvOut;
		if(logLinesPersist == null)
		{
			logLinesPersist = List();
		}
		logLinesPersist.add("LOG:" + nowStr + " Created monthly interest invoice " + nextInterestInvoiceNumber + " for " + sourceInvoiceNumber + " period " + periodKey + ".");
		startIdx = 0;
		if(logLinesPersist.size() > maxLogLinesToKeep)
		{
			startIdx = logLinesPersist.size() - maxLogLinesToKeep;
		}
		lineIdx = 0;
		for each  logLinePersist in logLinesPersist
		{
			if(lineIdx < startIdx)
			{
				lineIdx = lineIdx + 1;
				continue;
			}
			stageWrite = stageWrite + "\n" + logLinePersist.toString();
			lineIdx = lineIdx + 1;
		}
		persistedStageField = false;
		try 
		{
			if(sourceStageFieldCustomFieldId != "")
			{
				customFieldPayload = List();
				customFieldEntry = Map();
				customFieldEntry.put("customfield_id",sourceStageFieldCustomFieldId);
				customFieldEntry.put("value",stageWrite);
				customFieldPayload.add(customFieldEntry);
				customFieldResponse = invokeurl
				[
					url :apiBase + "/invoice/" + sourceInvoiceId + "/customfields?organization_id=" + orgId
					type :PUT
					parameters:{"JSONString":customFieldPayload.toString()}
					connection:"zbooks"
				];
				if(customFieldResponse != null && customFieldResponse.get("code") == 0)
				{
					persistedStageField = true;
				}
			}
			if(!persistedStageField)
			{
				customFieldList = List();
				customFieldMap = Map();
				if(sourceStageFieldCustomFieldId != "")
				{
					customFieldMap.put("customfield_id",sourceStageFieldCustomFieldId);
				}
				else
				{
					customFieldMap.put("api_name",stagesFieldApiName);
				}
				customFieldMap.put("value",stageWrite);
				customFieldList.add(customFieldMap);
				invoiceUpdatePayload = Map();
				invoiceUpdatePayload.put("custom_fields",customFieldList);
				if(sourceAllowPartialPaymentsPersist != null)
				{
					invoiceUpdatePayload.put("allow_partial_payments",sourceAllowPartialPaymentsPersist);
				}
				invoiceUpdateResponse = invokeurl
				[
					url :apiBase + "/invoices/" + sourceInvoiceId + "?organization_id=" + orgId
					type :PUT
					parameters:{"JSONString":invoiceUpdatePayload.toString()}
					connection:"zbooks"
				];
				if(invoiceUpdateResponse != null && invoiceUpdateResponse.get("code") == 0)
				{
					persistedStageField = true;
				}
			}
		}
		catch (persistError)
		{
			persistedStageField = false;
		}
		if(!persistedStageField)
		{
			warnPersist = "WARN/ALERT: Failed to persist interest token on source invoice " + sourceInvoiceNumber + ".";
			info warnPersist;
			runWarnings.add(warnPersist);
		}
	}
	interestSeq = interestSeq + 1;
	seqTextNext = interestSeq.toString();
	padNext = interestInvoiceNumberDigits - seqTextNext.length();
	if(padNext > 0)
	{
		for each  padNextStep in ITER_12
		{
			if(padNextStep > padNext)
			{
				break;
			}
			seqTextNext = "0" + seqTextNext;
		}
	}
	nextInterestInvoiceNumber = interestInvoicePrefix + seqTextNext;
}
if(runWarnings != null && runWarnings.size() > 0)
{
	seenWarnings = Map();
	for each  warningLine in runWarnings
	{
		if(warningLine != null && !seenWarnings.containsKey(warningLine.toString()))
		{
			info warningLine;
			seenWarnings.put(warningLine.toString(),true);
		}
	}
}
if(debugMode)
{
	info "Monthly Interest Billing completed. Scanned=" + scannedInvoicesCount + ", EligibleRent=" + eligibleRentInvoicesCount + ", InterestRowsPrepared=" + interestRowsPreparedCount + ", InterestInvoicesCreated=" + createdInterestInvoicesCount + ", EmailsSent=" + emailedInterestInvoicesCount;
}
