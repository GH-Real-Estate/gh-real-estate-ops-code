{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GH-Real-Estate/gh-real-estate-ops-code/src/zoho-contracts/schemas/contract-type-implementation.schema.json",
  "title": "GH Real Estate Residential Lease Contract Type Implementation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "implementation_id",
    "contract_type",
    "deployment_status",
    "source_manifest_ref",
    "crosswalk_ref",
    "field_map_ref",
    "template_components_ref",
    "attachment_requirements_ref",
    "clause_records",
    "recipient_manifests",
    "ending_text_variants",
    "addendum_b_variants",
    "production_gates"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/contract-type-implementation.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "implementation_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_type": {
      "const": "Residential Lease Agreement"
    },
    "deployment_status": {
      "$ref": "#/$defs/deployment_status"
    },
    "source_manifest_ref": {
      "type": "string",
      "minLength": 1
    },
    "crosswalk_ref": {
      "type": "string",
      "minLength": 1
    },
    "field_map_ref": {
      "type": "string",
      "minLength": 1
    },
    "template_components_ref": {
      "type": "string",
      "minLength": 1
    },
    "attachment_requirements_ref": {
      "type": "string",
      "minLength": 1
    },
    "clause_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "code",
              "path"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^RLA-[0-9]{3}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "recipient_manifests": {
      "$ref": "#/$defs/variant_paths"
    },
    "ending_text_variants": {
      "$ref": "#/$defs/variant_paths"
    },
    "addendum_b_variants": {
      "$ref": "#/$defs/variant_paths"
    },
    "production_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/production_gate"
      }
    },
    "template_structure": {},
    "reconciliation": {},
    "attachments": {},
    "addendum_b": {},
    "qa": {},
    "attorney_review_questions": {},
    "approval_workflow": {}
  },
  "$defs": {
    "deployment_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "published",
        "attorney_review_required",
        "execution_blocked",
        "signature_request_sent"
      ],
      "properties": {
        "state": {
          "const": "draft_only"
        },
        "published": {
          "const": false
        },
        "attorney_review_required": {
          "const": true
        },
        "execution_blocked": {
          "const": true
        },
        "signature_request_sent": {
          "const": false
        }
      }
    },
    "path_or_binding": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "manifest": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "variant_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_tenant",
        "two_tenants",
        "three_tenants"
      ],
      "properties": {
        "one_tenant": {
          "$ref": "#/$defs/path_or_binding"
        },
        "two_tenants": {
          "$ref": "#/$defs/path_or_binding"
        },
        "three_tenants": {
          "$ref": "#/$defs/path_or_binding"
        }
      }
    },
    "production_gate": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "gate_id",
        "status",
        "reason",
        "blocks"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "status": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
