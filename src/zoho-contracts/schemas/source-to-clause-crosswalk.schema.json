{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GH-Real-Estate/gh-real-estate-ops-code/src/zoho-contracts/schemas/source-to-clause-crosswalk.schema.json",
  "title": "GH Real Estate Residential Lease Source-to-Clause Crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "crosswalk_id",
    "source_manifest_ref",
    "entries"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/source-to-clause-crosswalk.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "crosswalk_id": {
      "type": "string",
      "minLength": 1
    },
    "source_manifest_ref": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "source_heading",
          "source_order",
          "target_kind",
          "target_ref",
          "target_style",
          "coverage_status",
          "gate_id"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_heading": {
            "type": "string",
            "minLength": 1
          },
          "source_order": {
            "type": "integer",
            "minimum": 1
          },
          "source_level": {
            "type": "string",
            "minLength": 1
          },
          "source_page": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ]
          },
          "target_kind": {
            "enum": [
              "clause",
              "template_component",
              "template_title",
              "template_toc",
              "template_article_heading",
              "ending_text",
              "attachment",
              "attachment_requirement",
              "addendum_b",
              "conditional_addendum",
              "not_applicable"
            ]
          },
          "target_ref": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "target_style": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "Title",
                  "Heading 1",
                  "Heading 2",
                  "Heading 3",
                  "Heading 4",
                  "Heading 5",
                  "Normal",
                  "Ending Text",
                  "Attachment"
                ]
              }
            ]
          },
          "coverage_status": {
            "enum": [
              "mapped",
              "deferred",
              "not_applicable"
            ]
          },
          "gate_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        }
      }
    },
    "source_outline_count": {
      "type": "integer",
      "minimum": 1
    },
    "coverage_summary": {
      "type": "object"
    },
    "unmapped_source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
