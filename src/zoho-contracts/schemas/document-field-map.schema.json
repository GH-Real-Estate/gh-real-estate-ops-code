{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GH-Real-Estate/gh-real-estate-ops-code/src/zoho-contracts/schemas/document-field-map.schema.json",
  "title": "GH Real Estate Residential Lease Document Field Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "map_id",
    "contract_type",
    "mappings"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/document-field-map.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "map_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_type": {
      "const": "Residential Lease Agreement"
    },
    "registry_ref": {
      "type": "string",
      "minLength": 1
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    },
    "unresolved_fields": {
      "type": "array"
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_variable",
        "business_meaning",
        "registry_field_id",
        "zoho_api_name",
        "api_name_status",
        "source_system",
        "snapshot_behavior",
        "status",
        "gate_id"
      ],
      "properties": {
        "source_variable": {
          "type": "string",
          "minLength": 1
        },
        "business_meaning": {
          "type": "string",
          "minLength": 1
        },
        "registry_field_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          ]
        },
        "zoho_api_name": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          ]
        },
        "api_name_status": {
          "enum": [
            "tenant_verification_required",
            "tenant_verified",
            "not_applicable"
          ]
        },
        "source_system": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_behavior": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "mapped",
            "approved_pending_live_metadata",
            "approved_pending_role_and_metadata_verification",
            "deferred",
            "not_applicable"
          ]
        },
        "gate_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "document_locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
