{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GH-Real-Estate/gh-real-estate-ops-code/src/zoho-contracts/schemas/clause-definition.schema.json",
  "title": "GH Real Estate Zoho Contracts Clause Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "clause_type",
    "clause_name",
    "zoho_api_name",
    "zoho_api_name_status",
    "library_question",
    "contract_type_question_overrides",
    "language_variants"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "clause_type": {
      "enum": [
        "Agreement Structure",
        "Parties, Premises and Term",
        "Rent, Fees and Payment",
        "Deposits and Prepaid Amounts",
        "Utilities and Services",
        "Use, Occupancy and Conduct",
        "Maintenance, Repairs and Condition",
        "Access and Inspection",
        "Animals and Accommodations",
        "Ancillary Storage",
        "Insurance, Risk and Liability",
        "Default, Remedies and Termination",
        "Personal Property and Abandonment",
        "Notices and Communications",
        "Compliance and Disclosures",
        "General Provisions"
      ]
    },
    "clause_name": {
      "type": "string",
      "minLength": 1
    },
    "zoho_api_name": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "zoho_api_name_status": {
      "enum": [
        "tenant_verification_required",
        "tenant_verified"
      ]
    },
    "library_question": {
      "type": "string",
      "minLength": 2,
      "pattern": "\\?\\s*$"
    },
    "contract_type_question_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_type",
          "question"
        ],
        "properties": {
          "contract_type": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 2,
            "pattern": "\\?\\s*$"
          }
        }
      }
    },
    "sign_recipient_manifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "purpose"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^R(?:[1-9]|1[0-9]|2[0-5])$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "language_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id",
          "variant_kind",
          "clause_title",
          "clause_title_style",
          "blocks"
        ],
        "properties": {
          "variant_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "variant_kind": {
            "enum": [
              "standard",
              "alternate"
            ]
          },
          "clause_title": {
            "type": "string",
            "minLength": 1
          },
          "clause_title_style": {
            "const": "Heading 2"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "style",
                "text"
              ],
              "properties": {
                "style": {
                  "enum": [
                    "Heading 3",
                    "Heading 4",
                    "Heading 5",
                    "Normal"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "zoho_api_name": {
            "type": "string"
          }
        },
        "required": [
          "zoho_api_name"
        ]
      },
      "then": {
        "properties": {
          "zoho_api_name_status": {
            "const": "tenant_verified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "zoho_api_name": {
            "type": "null"
          }
        },
        "required": [
          "zoho_api_name"
        ]
      },
      "then": {
        "properties": {
          "zoho_api_name_status": {
            "const": "tenant_verification_required"
          }
        }
      }
    }
  ]
}
