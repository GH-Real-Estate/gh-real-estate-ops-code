{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GH-Real-Estate/gh-real-estate-ops-code/src/zoho-contracts/schemas/source-manifest.schema.json",
  "title": "GH Real Estate Residential Lease Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "contract_type",
    "deployment_status",
    "sources",
    "source_units"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/source-manifest.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_type": {
      "const": "Residential Lease Agreement"
    },
    "deployment_status": {
      "$ref": "#/$defs/deployment_status"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "source_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_unit"
      }
    },
    "governance_baseline": {},
    "excluded_sources": {
      "type": "array"
    },
    "authority_baseline": {},
    "binary_storage_policy": {},
    "public_repository_normalization": {}
  },
  "$defs": {
    "deployment_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "published",
        "attorney_review_required",
        "execution_blocked",
        "signature_request_sent"
      ],
      "properties": {
        "state": {
          "const": "draft_only"
        },
        "published": {
          "const": false
        },
        "attorney_review_required": {
          "const": true
        },
        "execution_blocked": {
          "const": true
        },
        "signature_request_sent": {
          "const": false
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_id",
        "path",
        "filename",
        "role",
        "format",
        "sha256",
        "page_count",
        "status"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "revision_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "page_count": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "controlling": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_unit": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_ref",
        "source_heading",
        "source_order"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_heading": {
          "type": "string",
          "minLength": 1
        },
        "source_order": {
          "type": "integer",
          "minimum": 1
        },
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_anchor": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
