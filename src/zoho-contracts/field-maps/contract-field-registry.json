  "policies": {
    "integration_key": "Use the tenant-returned Zoho apiName, never a display label or guessed API name.",
    "api_name_verification": "All Zoho Contracts and CRM API names remain null until fetched from the authenticated metadata endpoints.",
    "source_of_truth": "CRM owns approved pre-authoring party, property, unit, and lease inputs. Zoho Contracts owns contract lifecycle fields and the resolved agreement snapshot. Executed document values are immutable snapshots.",
    "sync_direction": "Prefer one-way CRM-to-Contracts authoring. Do not create bidirectional field updates without an explicit conflict policy.",
    "public_repository": "Store definitions and validation only. Never store tenant names, addresses, phone numbers, emails, contract values, Zoho record IDs, OAuth tokens, or merged documents.",
    "date_interchange": "Use ISO 8601 YYYY-MM-DD between applications even though Zoho Contracts displays dates as MMM dd, yyyy.",
    "currency": "Zoho Contracts custom Currency uses the organization currency. Cross-application records must also carry or enforce the applicable ISO currency code.",
    "uploaded_template_limit": "Zoho states that Dropdown, Email, Phone, and Percent document fields cannot be mapped to system fields in uploaded templates."
  },
