{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GH-Real-Estate/gh-real-estate-ops-code/authority/schemas/promotion-release.schema.json",
  "title": "Reviewed authority discovery release record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "domain",
    "candidate_sha256",
    "candidate_generated_at",
    "approved_at",
    "approval",
    "validation_context_sha256",
    "notice"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-(?:legal|accounting)-[a-f0-9]{12}$"
    },
    "domain": { "enum": ["legal", "accounting"] },
    "candidate_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_generated_at": { "type": "string", "format": "date-time" },
    "approved_at": { "type": "string", "format": "date" },
    "approval": { "type": "object" },
    "validation_context_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "notice": {
      "const": "Reviewed discovery baseline only. Official source text controls. This release is not a legal or GAAP compliance certification."
    }
  }
}
