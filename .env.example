# Example environment variable names only.
# Do not put real values in this file.

# General safety
DRY_RUN=true
REQUIRE_LIVE_MODE_CONFIRMATION=true
LIVE_MODE_CONFIRMATION=
EXPECTED_LIVE_MODE_CONFIRMATION=GH_RETURNED_FEE_LIVE_APPROVED

# Zoho OAuth - store real values only in the runtime secret/config manager
ZOHO_CLIENT_ID=replace_me
ZOHO_CLIENT_SECRET=replace_me
ZOHO_REFRESH_TOKEN=replace_me

# Zoho account identifiers
ZOHO_BOOKS_ORG_ID=replace_me
ZOHO_PAYMENTS_ACCOUNT_ID=replace_me

# Returned payment webhook
ZPAYMENTS_WEBHOOK_SIGNING_KEY=replace_me
ZPAYMENTS_WEBHOOK_SIGNING_KEY_PREVIOUS=
RETURNED_FEE_ITEM_ID=replace_me
RETURNED_FEE_AMOUNT=replace_me
RETURNED_FEE_INVOICE_PREFIX=RF
RETURNED_FEE_LEDGER_FIELD_API_NAME=cf_returned_payment_fee_events
OPTIONAL_LATEST_RF_INVOICE_FIELD_API_NAME=cf_returned_fee_invoice_number
UPDATE_OPTIONAL_LATEST_RF_INVOICE_FIELD=false
SEND_INVOICE_ON_CREATE=false

# Optional diagnostics - keep disabled unless actively testing
ENABLE_HEALTH=false
HEALTH_CHECK_TOKEN=
ENABLE_OAUTH_DIAGNOSTIC=false
OAUTH_DIAGNOSTIC_TOKEN=
ENABLE_MOCK_PROCESSING=false
MOCK_PROCESSING_TOKEN=
