      "source_id": "congress-legislation-api",
      "publisher": "Library of Congress",
      "jurisdiction": "United States",
      "authority_type": "federal-legislation-candidate-index",
      "discovery_url": "https://api.congress.gov/v3/bill?format=json&limit=250",
      "adapter": "official_json_records",
      "storage_policy": "metadata-only",
      "cadence": "daily",
      "critical": false,
      "missing_detection": "rolling-window",
      "allowed_hosts": [
        "api.congress.gov"
      ],
      "records_path": "bills",
      "strict_records": true,
      "field_map": {
        "external_id": [
          "url"
        ],
        "title": [
          "title"
        ],
        "official_url": [
          "url"
        ],
        "published_at": [
          "updateDate",
          "latestAction.actionDate"
        ],
        "effective_at": [],
        "publisher_status": [
          "latestAction.text"
        ]
      },
      "metadata_fields": [
        "congress",
        "type",
        "number",
        "latestAction"
      ],
      "request": {
        "accept": "application/json",
        "timeout_seconds": 30,
        "max_bytes": 10485760,
        "api_key_required": true,
        "api_key_env": "CONGRESS_API_KEY",
        "api_key_query_param": "api_key"
      }
    },
    {
