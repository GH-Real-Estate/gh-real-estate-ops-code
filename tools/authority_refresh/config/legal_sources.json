{
  "version": 1,
  "purpose": "Discover candidate legal-authority changes from official publisher endpoints. Discovery is not a legal applicability or currentness decision.",
  "default_status": "discovered",
  "allowed_domains": [
    "api.congress.gov",
    "kscourts.gov",
    "kslegislature.gov",
    "searchdro.kscourts.gov",
    "sos.ks.gov",
    "uscode.house.gov",
    "www.ecfr.gov",
    "www.federalregister.gov",
    "www.govinfo.gov",
    "www.kscourts.gov",
    "www.kslegislature.gov",
    "codes.opkansas.org",
    "www.sos.ks.gov",
    "rules.ks.gov"
  ],
  "delegated_official_publishers": {
    "codes.opkansas.org": "City-linked electronic municipal-code publication platform. The City Clerk's master copy controls; discoveries remain manual-review.",
    "rules.ks.gov": "Kansas Secretary of State-linked rules portal. This catalog records the official redirect as metadata; substantive rules review remains manual."
  },
  "sources": [
    {
      "source_id": "ecfr-relevant-titles",
      "publisher": "Office of the Federal Register and Government Publishing Office",
      "jurisdiction": "United States",
      "authority_type": "federal-regulation-index",
      "discovery_url": "https://www.ecfr.gov/api/versioner/v1/titles.json",
      "adapter": "ecfr_titles_json",
      "storage_policy": "redistributable",
      "cadence": "daily",
      "critical": true,
      "minimum_items": 10,
      "allowed_hosts": [
        "www.ecfr.gov"
      ],
      "item_url_template": "https://www.ecfr.gov/current/title-{title_number}",
      "filters": {
        "title_numbers": [
          12,
          16,
          24,
          26,
          28,
          29,
          31,
          40,
          42,
          45
        ],
        "include_reserved": false
      },
      "request": {
        "accept": "application/json",
        "timeout_seconds": 30,
        "max_bytes": 2097152
      }
    },
    {
